diff --git a/apps/web/app/(api)/uploads/route.ts b/apps/web/app/(api)/uploads/route.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5216049138edd69430af6ac062cae9913ab9eb6b
--- /dev/null
+++ b/apps/web/app/(api)/uploads/route.ts
@@ -0,0 +1,95 @@
+import { z } from "zod";
+
+import { safeErrorEnvelope } from "@orbital-poc/core";
+
+import { ensureSchema, sql } from "../../../lib/db.server";
+import { refreshFolderState } from "../../../lib/folderState.server";
+import { putObject, validateStorageKey, verifySignature } from "../../../lib/objectStore.server";
+
+export const runtime = "nodejs";
+
+const QuerySchema = z.object({
+  storage_key: z.string().min(1),
+  expires: z.string().regex(/^[0-9]+$/),
+  sig: z.string().min(1),
+});
+
+export async function PUT(req: Request): Promise<Response> {
+  await ensureSchema();
+
+  const url = new URL(req.url);
+  const parsedQuery = QuerySchema.safeParse(Object.fromEntries(url.searchParams));
+  if (!parsedQuery.success) {
+    return Response.json(
+      safeErrorEnvelope({
+        code: "VALIDATION_ERROR",
+        message: "Invalid query params.",
+        details: parsedQuery.error.flatten(),
+      }),
+      { status: 400 },
+    );
+  }
+
+  const storageKey = parsedQuery.data.storage_key;
+  const keyValid = validateStorageKey(storageKey);
+  if (!keyValid.ok) {
+    return Response.json(safeErrorEnvelope({ code: "VALIDATION_ERROR", message: "Invalid storage_key." }), {
+      status: 400,
+    });
+  }
+
+  const expiresAtMs = Number(parsedQuery.data.expires);
+  if (!Number.isFinite(expiresAtMs) || expiresAtMs <= 0) {
+    return Response.json(safeErrorEnvelope({ code: "VALIDATION_ERROR", message: "Invalid expires param." }), {
+      status: 400,
+    });
+  }
+
+  if (Date.now() > expiresAtMs) {
+    return Response.json(safeErrorEnvelope({ code: "UNAUTHORISED", message: "Upload URL expired." }), { status: 403 });
+  }
+
+  const sigOk = verifySignature({ storageKey, expiresAtMs, sig: parsedQuery.data.sig });
+  if (!sigOk) {
+    return Response.json(safeErrorEnvelope({ code: "UNAUTHORISED", message: "Invalid upload signature." }), {
+      status: 403,
+    });
+  }
+
+  const docs = await sql<{ id: string; folder_id: string }[]>`
+    SELECT id, folder_id
+    FROM documents
+    WHERE storage_key = ${storageKey}
+    LIMIT 1
+  `;
+  const doc = docs[0];
+  if (!doc) {
+    return Response.json(safeErrorEnvelope({ code: "NOT_FOUND", message: "Document not found for storage_key." }), {
+      status: 404,
+    });
+  }
+
+  let bytes: Uint8Array;
+  try {
+    bytes = new Uint8Array(await req.arrayBuffer());
+  } catch {
+    return Response.json(safeErrorEnvelope({ code: "VALIDATION_ERROR", message: "Invalid request body." }), {
+      status: 400,
+    });
+  }
+
+  const result = await putObject({ storageKey, bytes });
+
+  await sql`
+    UPDATE documents
+    SET upload_completed_at = COALESCE(upload_completed_at, now()),
+        sha256 = ${result.sha256},
+        updated_at = now()
+    WHERE id = ${doc.id}
+  `;
+
+  await refreshFolderState(doc.folder_id);
+
+  return new Response(null, { status: 200 });
+}
+
diff --git a/apps/web/lib/db.server.ts b/apps/web/lib/db.server.ts
