+  }
+
+  return Response.json({
+    folder: {
+      id: folder.id,
+      name: folder.name,
+      state: folder.state,
+      latest_index_version: folder.latest_index_version,
+      created_at: folder.created_at.toISOString(),
+      updated_at: folder.updated_at.toISOString(),
