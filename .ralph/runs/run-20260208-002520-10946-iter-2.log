diff --git a/apps/web/lib/ingest/ingestQueue.server.ts b/apps/web/lib/ingest/ingestQueue.server.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bc27b6a0e8cc16ec6839efa81b67dbfb13e5df79
--- /dev/null
+++ b/apps/web/lib/ingest/ingestQueue.server.ts
@@ -0,0 +1,297 @@
+import "server-only";
+
+import { hashSnippet } from "@orbital-poc/core/citations/snippet";
+
+import { ensureSchema, sql } from "../db.server";
+import { refreshFolderState } from "../folderState.server";
+import { newId } from "../ids";
+import { readObject } from "../objectStore.server";
+
+type PdfJsTextItem = { str?: string };
+
+type PdfJsPage = {
+  getTextContent: () => Promise<{ items: PdfJsTextItem[] }>;
+};
+
+type PdfJsDoc = {
+  numPages: number;
+  getPage: (pageNumber: number) => Promise<PdfJsPage>;
+};
+
+type PdfJsModule = {
+  getDocument: (opts: { data: Uint8Array }) => { promise: Promise<PdfJsDoc> };
+};
+
+let pdfjsPromise: Promise<PdfJsModule> | null = null;
+
+async function loadPdfjs(): Promise<PdfJsModule> {
+  if (!pdfjsPromise) {
+    pdfjsPromise = import("pdfjs-dist/legacy/build/pdf.mjs") as unknown as Promise<PdfJsModule>;
+  }
+  return pdfjsPromise;
+}
+
+type DocForIngest = {
+  id: string;
+  folder_id: string;
+  storage_key: string | null;
+  upload_completed_at: string | null;
+  parse_status: "queued" | "parsing" | "parsed" | "failed";
+  ocr_status: "queued" | "running" | "done" | "failed";
+};
+
+const queue: string[] = [];
+const running = new Set<string>();
+let draining = false;
+
+export function enqueueDocumentIngest(documentId: string): void {
+  if (running.has(documentId)) return;
+  if (queue.includes(documentId)) return;
+  queue.push(documentId);
+  void drain();
+}
+
+async function drain(): Promise<void> {
+  if (draining) return;
+  draining = true;
+  try {
+    while (queue.length) {
+      const next = queue.shift();
+      if (!next) continue;
+      if (running.has(next)) continue;
+      running.add(next);
+      try {
+        await ingestOne(next);
+      } finally {
+        running.delete(next);
+      }
+    }
+  } finally {
+    draining = false;
+  }
+}
+
+function safeError(code: string, message: string): Record<string, unknown> {
+  return { code, message };
+}
+
+async function failDocument(args: {
+  documentId: string;
+  folderId: string;
+  error: Record<string, unknown>;
+}): Promise<void> {
+  await sql`
+    UPDATE documents
+    SET parse_status = 'failed',
+        ocr_status = 'failed',
+        error_json = ${args.error}::jsonb,
+        updated_at = now()
+    WHERE id = ${args.documentId}
+  `;
+  await refreshFolderState(args.folderId);
+}
+
+async function ingestOne(documentId: string): Promise<void> {
+  await ensureSchema();
+
+  const docs = await sql<DocForIngest[]>`
+    SELECT id, folder_id, storage_key, upload_completed_at, parse_status, ocr_status
+    FROM documents
+    WHERE id = ${documentId}
+    LIMIT 1
+  `;
+  const doc = docs[0];
+  if (!doc) return;
+
+  // Idempotency: don't restart successful/failed ingests.
+  if (doc.parse_status === "parsed" && doc.ocr_status === "done") return;
+  if (doc.parse_status === "failed" || doc.ocr_status === "failed") return;
+
+  if (!doc.storage_key) {
+    await failDocument({
+      documentId,
+      folderId: doc.folder_id,
+      error: safeError("MISSING_STORAGE_KEY", "Document is missing storage_key."),
+    });
+    return;
+  }
+
+  if (!doc.upload_completed_at) {
+    await failDocument({
+      documentId,
+      folderId: doc.folder_id,
+      error: safeError("UPLOAD_NOT_COMPLETE", "Upload has not completed yet."),
+    });
+    return;
+  }
+
+  await sql`
+    UPDATE documents
+    SET parse_status = 'parsing',
+        ocr_status = 'running',
+        error_json = NULL,
+        updated_at = now()
+    WHERE id = ${documentId}
+      AND parse_status = 'queued'
+      AND ocr_status = 'queued'
+  `;
+  await refreshFolderState(doc.folder_id);
+
+  let bytes: Uint8Array;
+  try {
+    bytes = await readObject(doc.storage_key);
+  } catch {
+    await failDocument({
+      documentId,
+      folderId: doc.folder_id,
+      error: safeError("UPLOAD_MISSING", "Raw PDF not found for storage_key."),
+    });
+    return;
+  }
+
+  const pdfjs = await loadPdfjs();
+
+  let pdf: PdfJsDoc;
+  try {
+    pdf = await pdfjs.getDocument({ data: bytes }).promise;
+  } catch {
+    await failDocument({
+      documentId,
+      folderId: doc.folder_id,
+      error: safeError("PDF_PARSE_FAILED", "Unable to parse PDF."),
+    });
+    return;
+  }
+
+  const pageCount = typeof pdf.numPages === "number" && Number.isFinite(pdf.numPages) ? pdf.numPages : 0;
+  if (pageCount <= 0) {
+    await failDocument({
+      documentId,
+      folderId: doc.folder_id,
+      error: safeError("PDF_PAGE_COUNT_INVALID", "Parsed PDF had no pages."),
+    });
+    return;
+  }
+
+  await sql`
+    UPDATE documents
+    SET parse_status = 'parsed',
+        page_count = ${pageCount},
+        updated_at = now()
+    WHERE id = ${documentId}
+  `;
+  await refreshFolderState(doc.folder_id);
+
+  const pages: Array<{ page_number: number; text: string; layout_json: Record<string, unknown> }> = [];
+  let totalChars = 0;
+
+  for (let pageNumber = 1; pageNumber <= pageCount; pageNumber++) {
+    const page = await pdf.getPage(pageNumber);
+    const content = await page.getTextContent();
+    const items = Array.isArray(content.items) ? content.items : [];
+    const text = items.map((i) => String(i?.str ?? "")).join(" ").replace(/\s+/g, " ").trim();
+    totalChars += text.length;
+    pages.push({
+      page_number: pageNumber,
+      text,
+      layout_json: {
+        source: "pdfjs",
+        schema_version: "layout_v0",
+        has_geometry: false,
+        item_count: items.length,
+      },
+    });
+  }
+
+  const avgCharsPerPage = totalChars / pageCount;
+  const extractionQuality = Math.max(0, Math.min(1, avgCharsPerPage / 1000));
+  const extractionQualityMethod = "pdfjs_text_chars_per_page_v1";
+
+  const folders = await sql<{ latest_index_version: string }[]>`
+    SELECT latest_index_version
+    FROM folders
+    WHERE id = ${doc.folder_id}
+    LIMIT 1
+  `;
+  const indexVersion = folders[0]?.latest_index_version ?? "v1";
+
+  try {
+    await sql.begin(async (tx) => {
+      await tx`DELETE FROM document_pages WHERE document_id = ${documentId}`;
+      for (const p of pages) {
+        await tx`
+          INSERT INTO document_pages (id, document_id, page_number, text, layout_json, created_at, updated_at)
+          VALUES (
+            ${newId("pg")},
+            ${documentId},
+            ${p.page_number},
+            ${p.text},
+            ${p.layout_json}::jsonb,
+            now(),
+            now()
+          )
+        `;
+      }
+
+      await tx`
+        UPDATE documents
+        SET ocr_status = 'done',
+            extraction_quality = ${extractionQuality},
+            metadata_json = jsonb_set(metadata_json, '{extraction_quality_method}', to_jsonb(${extractionQualityMethod}::text), true),
+            updated_at = now()
+        WHERE id = ${documentId}
+      `;
+
+      await tx`
+        DELETE FROM chunks
+        WHERE document_id = ${documentId}
+          AND index_version = ${indexVersion}
+      `;
+
+      // Minimal chunking: one chunk per page.
+      for (let i = 0; i < pages.length; i++) {
+        const p = pages[i]!;
+        const textHash = hashSnippet(p.text);
+        await tx`
+          INSERT INTO chunks (
+            id,
+            document_id,
+            index_version,
+            chunk_index,
+            page_start,
+            page_end,
+            text,
+            metadata_json,
+            text_hash,
+            created_at
+          )
+          VALUES (
+            ${newId("chk")},
+            ${documentId},
+            ${indexVersion},
+            ${i},
+            ${p.page_number},
+            ${p.page_number},
+            ${p.text},
+            ${({ page_number: p.page_number } satisfies Record<string, unknown>)}::jsonb,
+            ${textHash},
+            now()
+          )
+        `;
+      }
+    });
+  } catch {
+    await sql`
+      UPDATE documents
+      SET ocr_status = 'failed',
+          error_json = ${safeError("INGEST_FAILED", "Ingest failed while writing extracted pages.")}::jsonb,
+          updated_at = now()
+      WHERE id = ${documentId}
+    `;
+    await refreshFolderState(doc.folder_id);
+    return;
+  }
+
+  await refreshFolderState(doc.folder_id);
+}
+
diff --git a/apps/web/lib/objectStore.server.ts b/apps/web/lib/objectStore.server.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b2e523fb20ee44ea53dd14dd6c1c72a73fdaf1a3
--- /dev/null
+++ b/apps/web/lib/objectStore.server.ts
@@ -0,0 +1,103 @@
+import "server-only";
+
+import { createHash, createHmac, timingSafeEqual } from "node:crypto";
+import fs from "node:fs";
+import path from "node:path";
+
+type GlobalObj = typeof globalThis & {
+  __orbitalObjectStoreSecret?: string;
+};
+
+const STORAGE_KEY_RE = /^folders\/[A-Za-z0-9_-]+\/documents\/[A-Za-z0-9_-]+\.pdf$/;
+
+function objectStoreRoot(): string {
+  // In Next dev, `process.cwd()` resolves to `apps/web`.
+  return path.resolve(process.cwd(), "../../tmp/object-store");
+}
+
+export function validateStorageKey(storageKey: string): { ok: true } | { ok: false; reason: string } {
+  if (!STORAGE_KEY_RE.test(storageKey)) return { ok: false, reason: "INVALID_STORAGE_KEY" };
+  return { ok: true };
+}
+
+function resolveObjectPath(storageKey: string): string {
+  const base = objectStoreRoot();
+  const candidate = path.resolve(base, storageKey);
+  if (!candidate.startsWith(base + path.sep)) throw new Error("PATH_TRAVERSAL");
+  return candidate;
+}
+
+function secret(): string {
+  const fromEnv = process.env.OBJECT_STORE_SIGNING_SECRET;
+  if (fromEnv && fromEnv.trim()) return fromEnv.trim();
+
+  // Dev-only fallback so local upload works out of the box.
+  const g = globalThis as GlobalObj;
+  if (!g.__orbitalObjectStoreSecret) {
+    g.__orbitalObjectStoreSecret = `dev-${Math.random().toString(36).slice(2)}-${Date.now()}`;
+  }
+  return g.__orbitalObjectStoreSecret;
+}
+
+function b64url(input: Buffer): string {
+  return input
+    .toString("base64")
+    .replace(/=/g, "")
+    .replace(/\+/g, "-")
+    .replace(/\//g, "_");
+}
+
+function sign(storageKey: string, expiresAtMs: number): string {
+  const payload = `${storageKey}\n${expiresAtMs}`;
+  const digest = createHmac("sha256", secret()).update(payload).digest();
+  return b64url(digest);
+}
+
+export function verifySignature(args: { storageKey: string; expiresAtMs: number; sig: string }): boolean {
+  const expected = sign(args.storageKey, args.expiresAtMs);
+  const a = Buffer.from(expected);
+  const b = Buffer.from(args.sig);
+  if (a.length !== b.length) return false;
+  return timingSafeEqual(a, b);
+}
+
+export function createSignedPutUrl(args: {
+  origin: string;
+  storageKey: string;
+  expiresInSeconds?: number;
+}): { url: string; expires_at_ms: number } {
+  const expiresInSeconds = args.expiresInSeconds ?? 10 * 60;
+  const expiresAtMs = Date.now() + expiresInSeconds * 1000;
+  const sig = sign(args.storageKey, expiresAtMs);
+
+  const url = new URL("/uploads", args.origin);
+  url.searchParams.set("storage_key", args.storageKey);
+  url.searchParams.set("expires", String(expiresAtMs));
+  url.searchParams.set("sig", sig);
+
+  return { url: url.toString(), expires_at_ms: expiresAtMs };
+}
+
+export function objectExists(storageKey: string): boolean {
+  const p = resolveObjectPath(storageKey);
+  return fs.existsSync(p);
+}
+
+export async function putObject(args: {
+  storageKey: string;
+  bytes: Uint8Array;
+}): Promise<{ bytesWritten: number; sha256: string }> {
+  const p = resolveObjectPath(args.storageKey);
+  fs.mkdirSync(path.dirname(p), { recursive: true });
+  await fs.promises.writeFile(p, args.bytes);
+
+  // Hash in-process to avoid extra reads.
+  const hash = createHash("sha256").update(args.bytes).digest("hex");
+  return { bytesWritten: args.bytes.byteLength, sha256: `sha256:${hash}` };
+}
+
+export async function readObject(storageKey: string): Promise<Uint8Array> {
+  const p = resolveObjectPath(storageKey);
+  const buf = await fs.promises.readFile(p);
+  return new Uint8Array(buf);
+}
diff --git a/scripts/us002_smoke.ts b/scripts/us002_smoke.ts
new file mode 100644
index 0000000000000000000000000000000000000000..49ddf486165d8b295a4a9c85b1c61aab3fd19446
--- /dev/null
+++ b/scripts/us002_smoke.ts
@@ -0,0 +1,180 @@
+import fs from "node:fs";
+import path from "node:path";
+
+import { POST as createFolder } from "../apps/web/app/(api)/folders/route.ts";
+import { GET as getFolder } from "../apps/web/app/(api)/folders/[id]/route.ts";
+import { GET as listDocs, POST as initUpload } from "../apps/web/app/(api)/folders/[id]/documents/route.ts";
+import { POST as completeUpload } from "../apps/web/app/(api)/documents/[id]/complete/route.ts";
+import { PUT as putUpload } from "../apps/web/app/(api)/uploads/route.ts";
+
+function repoRoot(): string {
+  return path.resolve(process.cwd());
+}
+
+function sleep(ms: number): Promise<void> {
+  return new Promise((r) => setTimeout(r, ms));
+}
+
+async function mustJson(res: Response): Promise<any> {
+  const json = await res.json().catch(() => null);
+  if (!json) throw new Error(`Expected JSON response, got status=${res.status}`);
+  return json;
+}
+
+async function main() {
+  const folderRes = await createFolder(
+    new Request("http://local/folders", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ name: `US-002 smoke (${new Date().toISOString()})` }),
+    }),
+  );
+  if (!folderRes.ok) {
+    const json = await mustJson(folderRes);
+    throw new Error(`Create folder failed: ${JSON.stringify(json)}`);
+  }
+  const folderJson = await mustJson(folderRes);
+  const folderId = String(folderJson.folder?.id ?? "");
+  if (!folderId) throw new Error("Missing folder.id from create response.");
+
+  const files = [
+    {
+      pack: "pack_01_clean",
+      filename: "TitleCommitment.pdf",
+    },
+    {
+      pack: "pack_07_scans_rotated_low_quality",
+      filename: "ALTA_Survey_SCANNED_ROTATED.pdf",
+    },
+  ];
+
+  const docs: Array<{ id: string; storage_key: string; filename: string }> = [];
+
+  for (const f of files) {
+    const filePath = path.resolve(repoRoot(), "docs/08-example-data", f.pack, "docs", f.filename);
+    const bytes = new Uint8Array(fs.readFileSync(filePath));
+
+    const initRes = await initUpload(
+      new Request(`http://local/folders/${folderId}/documents`, {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ filename: f.filename, mime: "application/pdf", bytes: bytes.byteLength }),
+      }),
+      { params: Promise.resolve({ id: folderId }) as any },
+    );
+    if (!initRes.ok) {
+      const json = await mustJson(initRes);
+      throw new Error(`Init upload failed: ${JSON.stringify(json)}`);
+    }
+
+    const initJson = await mustJson(initRes);
+    const documentId = String(initJson.document?.id ?? "");
+    const storageKey = String(initJson.upload?.storage_key ?? "");
+    const uploadUrl = String(initJson.upload?.url ?? "");
+
+    if (!documentId || !storageKey || !uploadUrl) {
+      throw new Error(`Init upload response missing fields: ${JSON.stringify(initJson)}`);
+    }
+
+    const putRes = await putUpload(
+      new Request(uploadUrl, {
+        method: "PUT",
+        headers: { "Content-Type": "application/pdf" },
+        body: bytes,
+      }),
+    );
+    if (!putRes.ok) {
+      const json = await mustJson(putRes);
+      throw new Error(`PUT upload failed: ${JSON.stringify(json)}`);
+    }
+
+    docs.push({ id: documentId, storage_key: storageKey, filename: f.filename });
+  }
+
+  // Negative case: wrong storage_key -> VALIDATION_ERROR.
+  const bad = await completeUpload(
+    new Request(`http://local/documents/${docs[0]!.id}/complete`, {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ storage_key: `${docs[0]!.storage_key}.wrong` }),
+    }),
+    { params: Promise.resolve({ id: docs[0]!.id }) as any },
+  );
+  if (bad.status !== 400) {
+    throw new Error(`Expected 400 for wrong storage_key, got ${bad.status}`);
+  }
+  const badJson = await mustJson(bad);
+  if (String(badJson?.error?.code ?? "") !== "VALIDATION_ERROR") {
+    throw new Error(`Expected VALIDATION_ERROR, got ${JSON.stringify(badJson)}`);
+  }
+
+  for (const d of docs) {
+    const completeRes = await completeUpload(
+      new Request(`http://local/documents/${d.id}/complete`, {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ storage_key: d.storage_key }),
+      }),
+      { params: Promise.resolve({ id: d.id }) as any },
+    );
+    if (!completeRes.ok) {
+      const json = await mustJson(completeRes);
+      throw new Error(`Complete upload failed: ${JSON.stringify(json)}`);
+    }
+  }
+
+  const seen: Record<string, { parse: Set<string>; ocr: Set<string> }> = {};
+  for (const d of docs) seen[d.id] = { parse: new Set(), ocr: new Set() };
+
+  const deadline = Date.now() + 60_000;
+  while (Date.now() < deadline) {
+    const listRes = await listDocs(new Request(`http://local/folders/${folderId}/documents`), {
+      params: Promise.resolve({ id: folderId }) as any,
+    });
+    if (!listRes.ok) {
+      const json = await mustJson(listRes);
+      throw new Error(`List documents failed: ${JSON.stringify(json)}`);
+    }
+    const json = await mustJson(listRes);
+    const items: any[] = Array.isArray(json.documents) ? json.documents : [];
+    const byId = new Map(items.map((it) => [String(it.id), it]));
+
+    let doneCount = 0;
+    for (const d of docs) {
+      const it = byId.get(d.id);
+      if (!it) continue;
+      const parse = String(it.parse_status ?? "");
+      const ocr = String(it.ocr_status ?? "");
+      seen[d.id]!.parse.add(parse);
+      seen[d.id]!.ocr.add(ocr);
+
+      const terminal = ["parsed", "failed"].includes(parse) && ["done", "failed"].includes(ocr);
+      if (terminal) doneCount++;
+    }
+
+    if (doneCount === docs.length) break;
+    await sleep(200);
+  }
+
+  const folderStateRes = await getFolder(new Request(`http://local/folders/${folderId}`), {
+    params: Promise.resolve({ id: folderId }) as any,
+  });
+  if (!folderStateRes.ok) {
+    const json = await mustJson(folderStateRes);
+    throw new Error(`Get folder failed: ${JSON.stringify(json)}`);
+  }
+  const folderStateJson = await mustJson(folderStateRes);
+  const folderState = String(folderStateJson.folder?.state ?? "");
+
+  const intermediateSeen = docs.some((d) => seen[d.id]!.parse.has("parsing") || seen[d.id]!.ocr.has("running"));
+  if (!intermediateSeen) {
+    throw new Error(`Did not observe any intermediate ingest states. Seen=${JSON.stringify(Object.fromEntries(Object.entries(seen).map(([id, s]) => [id, { parse: [...s.parse], ocr: [...s.ocr] }])))} `);
+  }
+
+  process.stdout.write(`US-002 smoke OK: folder=${folderId} state=${folderState}\n`);
+}
+
+main().catch((err) => {
+  process.stderr.write(`${err instanceof Error ? err.stack : String(err)}\n`);
+  process.exit(1);
+});

