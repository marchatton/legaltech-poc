#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

cmd="${1:-}"
shift || true

case "$cmd" in
  log)
    if [[ $# -lt 1 ]]; then
      echo "Usage: ralph log <message>" >&2
      exit 2
    fi

    ts="$(date '+%Y-%m-%d %H:%M:%S')"
    mkdir -p "${ROOT}/.ralph"
    printf '[%s] %s\n' "$ts" "$*" >> "${ROOT}/.ralph/activity.log"
    ;;

  *)
    echo "Usage: ralph log <message>" >&2
    exit 2
    ;;
esac

