{
  "name": "@orbital-poc/web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "node --experimental-strip-types scripts/dev.ts",
    "worker": "node --experimental-strip-types scripts/worker.ts",
    "build": "node --experimental-strip-types scripts/build.ts",
    "start": "next start",
    "lint": "next lint",
    "test:push": "vitest run --exclude \"test/**/*.int.test.ts\"",
    "test:int": "vitest run test/*.int.test.ts test/*.e2e.int.test.ts",
    "test:smoke:allowlist": "vitest run test/demoPackAllowlist.sync.test.ts test/demoLoadPack.validation.test.ts",
    "test:smoke:operator-pack09": "vitest run test/realDataWorkflows.e2e.int.test.ts --testNamePattern \"operator smoke: load-pack bad citation flow stays export-blocked\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/gateway": "2.0.35",
    "@orbital-poc/core": "workspace:*",
    "ai": "5.0.129",
    "docx": "^9.5.1",
    "next": "^15.0.0",
    "pdfjs-dist": "^4.0.0",
    "postgres": "^3.4.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.0.0",
    "tailwindcss": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
