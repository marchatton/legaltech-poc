            0.15454545454545454
          ],
          "anchor": "SECTION_RECORDING_INFORMATION"
        },
        {
          "text": "Instrument No.: 2019-454347 | Recorded: April 08, 2019 | County/State: Fulton County, GA",
          "bbox": [
            0.08823529411764706,
            0.16015151515151516,
            0.7132328431372549,
