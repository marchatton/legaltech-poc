          ],
          "anchor": "REC_INFO"
        },
        {
          "text": "Grant of Easement",
          "bbox": [
            0.08823529411764706,
            0.1924242424242424,
            0.24804084967320258,
            0.2090909090909091
          ],
          "anchor": "SECTION_GRANT_OF_EASEMENT"
        },
        {
          "text": "Grantor hereby grants to Grantee a 10' wide exclusive utility easement (the 'Utility Easement')",
          "bbox": [
            0.08823529411764706,
            0.21469696969696983,
            0.7303700980392156,
            0.22909090909090912
          ],
          "anchor": "GRANT_CLAUSE"
        },
        {
          "text": "over the Easement Area described in Exhibit B.",
          "bbox": [
            0.08823529411764706,
            0.2310606060606062,
            0.41350163398692813,
            0.2454545454545456
          ]
        },
        {
          "text": "The Utility Easement permits installation, operation, maintenance, repair, replacement and removal",
          "bbox": [
            0.08823529411764706,
            0.24742424242424266,
            0.7671903594771242,
            0.26181818181818195
          ]
        },
        {
          "text": "of utility lines and related appurtenances.",
          "bbox": [
            0.08823529411764706,
            0.263787878787879,
            0.3703790849673203,
            0.2781818181818184
          ]
        },
        {
          "text": "Restrictions",
          "bbox": [
            0.08823529411764706,
            0.29606060606060625,
            0.1921062091503268,
            0.31272727272727296
          ],
          "anchor": "SECTION_RESTRICTIONS"
        },
        {
          "text": "No permanent structures shall be constructed within the Utility Easement Area without the prior",
          "bbox": [
            0.08823529411764706,
            0.3183333333333336,
            0.7395906862745099,
            0.332727272727273
          ],
          "anchor": "NO_STRUCTURES"
        },
        {
          "text": "written consent of Grantee.",
          "bbox": [
            0.08823529411764706,
            0.33469696969697005,
            0.2746029411764706,
            0.34909090909090945
          ]
        },
        {
          "text": "Temporary paving and striping may be permitted provided it does not materially interfere with",
          "bbox": [
            0.08823529411764706,
            0.3510606060606063,
            0.7257753267973855,
            0.3654545454545457
          ]
        },
        {
          "text": "utility operations.",
          "bbox": [
            0.08823529411764706,
            0.36742424242424276,
            0.20470343137254904,
            0.38181818181818206
          ]
        },
        {
          "text": "Relocation",
          "bbox": [
            0.08823529411764706,
            0.3996969696969699,
            0.18011764705882352,
            0.4163636363636366
          ],
          "anchor": "SECTION_RELOCATION"
        },
        {
          "text": "Grantor reserves a right to request relocation of the utility facilities, subject to Grantee's",
          "bbox": [
            0.08823529411764706,
            0.4219696969696972,
            0.6856331699346405,
            0.4363636363636365
          ],
          "anchor": "RELOCATION_RIGHT"
        },
        {
          "text": "reasonable approval and at Grantor's sole cost and expense.",
          "bbox": [
            0.08823529411764706,
            0.43833333333333346,
            0.5070890522875817,
            0.45272727272727287
          ]
        },
        {
          "text": "Relocation shall not unreasonably interrupt service.",
          "bbox": [
            0.08823529411764706,
            0.4546969696969698,
            0.44023202614379087,
            0.4690909090909092
          ]
        },
        {
          "text": "Exhibit B",
          "bbox": [
            0.08823529411764706,
            0.48696969696969705,
            0.16613398692810458,
            0.5036363636363637
          ],
          "anchor": "SECTION_EXHIBIT_B"
        },
        {
          "text": "EXHIBIT B (legal description of easement area) is referenced in this instrument but is not attached",
          "bbox": [
            0.08823529411764706,
            0.5092424242424243,
            0.7620522875816994,
            0.5236363636363637
          ],
          "anchor": "EXHIBIT_B_NOTE"
        },
        {
          "text": "to this PDF.",
          "bbox": [
            0.08823529411764706,
            0.5256060606060606,
            0.16932679738562093,
            0.54
          ]
        },
        {
          "text": "Easement Area: a strip of land along the north (or east) boundary line as depicted on the Site",
          "bbox": [
            0.08823529411764706,
            0.541969696969697,
            0.7267377450980392,
            0.5563636363636364
          ]
        },
        {
          "text": "Plan.",
          "bbox": [
            0.08823529411764706,
