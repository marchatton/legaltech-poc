          ],
          "anchor": "SECTION_RECORDING_INFORMATION"
        },
        {
          "text": "Instrument No.: 2023-623033 | Recorded: October 22, 2023 | County/State: Cook County, IL",
          "bbox": [
            0.08823529411764706,
            0.16015151515151516,
            0.7210098039215687,
            0.17454545454545456
          ],
          "anchor": "REC_INFO"
        },
        {
          "text": "Parcel Limitation",
          "bbox": [
            0.08823529411764706,
            0.1924242424242424,
            0.2330686274509804,
            0.2090909090909091
          ],
          "anchor": "SECTION_PARCEL_LIMITATION"
        },
        {
          "text": "This Utility Easement burdens Parcel 1 only.",
          "bbox": [
            0.08823529411764706,
            0.21469696969696983,
            0.39276307189542486,
            0.22909090909090912
          ],
          "anchor": "PARCEL_LIMIT"
        },
        {
          "text": "This easement does not encumber any other parcel unless expressly stated.",
          "bbox": [
            0.08823529411764706,
            0.2310606060606062,
            0.6127998366013072,
            0.2454545454545456
          ]
        },
        {
          "text": "Grant of Easement",
          "bbox": [
            0.08823529411764706,
            0.2633333333333334,
            0.24804084967320258,
            0.28000000000000014
          ],
          "anchor": "SECTION_GRANT_OF_EASEMENT"
        },
        {
          "text": "Grantor hereby grants to Grantee a 15' wide non-exclusive utility easement (the 'Utility Easement')",
          "bbox": [
            0.08823529411764706,
            0.28560606060606075,
            0.7614313725490197,
            0.30000000000000016
          ],
          "anchor": "GRANT_CLAUSE"
        },
        {
          "text": "over the Easement Area described in Exhibit B.",
          "bbox": [
            0.08823529411764706,
            0.3019696969696972,
            0.41350163398692813,
            0.3163636363636366
          ]
        },
        {
          "text": "The Utility Easement permits installation, operation, maintenance, repair, replacement and removal",
          "bbox": [
            0.08823529411764706,
            0.3183333333333336,
            0.7671903594771242,
            0.332727272727273
          ]
        },
        {
          "text": "of utility lines and related appurtenances.",
          "bbox": [
            0.08823529411764706,
            0.33469696969697005,
            0.3703790849673203,
            0.34909090909090945
          ]
        },
        {
          "text": "Restrictions",
          "bbox": [
            0.08823529411764706,
            0.3669696969696973,
            0.1921062091503268,
            0.3836363636363639
          ],
          "anchor": "SECTION_RESTRICTIONS"
        },
        {
          "text": "No permanent structures shall be constructed within the Utility Easement Area without the prior",
          "bbox": [
            0.08823529411764706,
            0.3892424242424245,
            0.7395906862745099,
            0.4036363636363639
          ],
          "anchor": "NO_STRUCTURES"
        },
        {
          "text": "written consent of Grantee.",
          "bbox": [
            0.08823529411764706,
            0.40560606060606086,
            0.2746029411764706,
            0.42000000000000015
          ]
        },
        {
          "text": "Temporary paving and striping may be permitted provided it does not materially interfere with",
          "bbox": [
            0.08823529411764706,
            0.4219696969696972,
            0.7257753267973855,
            0.4363636363636365
          ]
        },
        {
          "text": "utility operations.",
          "bbox": [
            0.08823529411764706,
            0.43833333333333346,
            0.20470343137254904,
            0.45272727272727287
          ]
        },
        {
          "text": "Relocation",
          "bbox": [
            0.08823529411764706,
            0.4706060606060607,
            0.18011764705882352,
            0.4872727272727274
          ],
          "anchor": "SECTION_RELOCATION"
        },
        {
          "text": "Grantor reserves a right to request relocation of the utility facilities, subject to Grantee's",
          "bbox": [
            0.08823529411764706,
            0.4928787878787879,
            0.6856331699346405,
            0.5072727272727273
          ],
          "anchor": "RELOCATION_RIGHT"
        },
        {
          "text": "reasonable approval and at Grantor's sole cost and expense.",
          "bbox": [
            0.08823529411764706,
            0.5092424242424243,
            0.5070890522875817,
            0.5236363636363637
          ]
        },
        {
          "text": "Relocation shall not unreasonably interrupt service.",
          "bbox": [
            0.08823529411764706,
            0.5256060606060606,
            0.44023202614379087,
            0.54
          ]
        },
        {
          "text": "Exhibit B",
          "bbox": [
            0.08823529411764706,
            0.5578787878787879,
            0.16613398692810458,
            0.5745454545454545
          ],
          "anchor": "SECTION_EXHIBIT_B"
        },
        {
          "text": "EXHIBIT B is attached and depicts the easement area (synthetic).",
          "bbox": [
            0.08823529411764706,
            0.5801515151515151,
            0.5403390522875817,
            0.5945454545454545
          ],
          "anchor": "EXHIBIT_B_NOTE"
        },
        {
          "text": "Easement Area: a strip of land along the north (or east) boundary line as depicted on the Site",
          "bbox": [
            0.08823529411764706,
            0.5965151515151514,
            0.7267377450980392,
            0.6109090909090908
          ]
        },
        {
          "text": "Plan.",
          "bbox": [
            0.08823529411764706,
            0.6128787878787878,
            0.12361192810457515,
            0.6272727272727272
          ]
        }
      ]
    }
