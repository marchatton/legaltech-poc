            0.28096895424836604,
            0.8621212121212122
          ],
          "anchor": "SECTION_RECORDING_INFORMATION"
        },
        {
          "text": "Instrument No.: 2023-623033 | Recorded: October 22, 2023 | County/State: Cook County, IL",
          "bbox": [
            0.08823529411764706,
            0.8254545454545454,
            0.7210098039215687,
            0.8398484848484848
          ],
          "anchor": "REC_INFO"
        },
        {
          "text": "Parcel Limitation",
          "bbox": [
            0.08823529411764706,
            0.7909090909090909,
            0.2330686274509804,
            0.8075757575757576
          ],
          "anchor": "SECTION_PARCEL_LIMITATION"
        },
        {
          "text": "This Utility Easement burdens Parcel 1 only.",
          "bbox": [
            0.08823529411764706,
            0.7709090909090909,
            0.39276307189542486,
            0.7853030303030302
          ],
          "anchor": "PARCEL_LIMIT"
        },
        {
          "text": "This easement does not encumber any other parcel unless expressly stated.",
          "bbox": [
            0.08823529411764706,
            0.7545454545454544,
            0.6127998366013072,
            0.7689393939393938
          ]
        },
        {
          "text": "Grant of Easement",
          "bbox": [
            0.08823529411764706,
            0.7199999999999999,
            0.24804084967320258,
            0.7366666666666666
          ],
          "anchor": "SECTION_GRANT_OF_EASEMENT"
        },
        {
          "text": "Grantor hereby grants to Grantee a 15' wide non-exclusive utility easement (the 'Utility Easement')",
          "bbox": [
            0.08823529411764706,
            0.6999999999999998,
            0.7614313725490197,
            0.7143939393939392
          ],
          "anchor": "GRANT_CLAUSE"
        },
        {
          "text": "over the Easement Area described in Exhibit B.",
          "bbox": [
            0.08823529411764706,
            0.6836363636363634,
            0.41350163398692813,
            0.6980303030303028
          ]
        },
        {
          "text": "The Utility Easement permits installation, operation, maintenance, repair, replacement and removal",
          "bbox": [
            0.08823529411764706,
            0.667272727272727,
            0.7671903594771242,
            0.6816666666666664
          ]
        },
        {
          "text": "of utility lines and related appurtenances.",
          "bbox": [
            0.08823529411764706,
            0.6509090909090905,
            0.3703790849673203,
            0.66530303030303
          ]
        },
        {
          "text": "Restrictions",
          "bbox": [
            0.08823529411764706,
            0.6163636363636361,
            0.1921062091503268,
            0.6330303030303027
          ],
          "anchor": "SECTION_RESTRICTIONS"
        },
        {
          "text": "No permanent structures shall be constructed within the Utility Easement Area without the prior",
          "bbox": [
            0.08823529411764706,
            0.5963636363636361,
            0.7395906862745099,
            0.6107575757575755
          ],
          "anchor": "NO_STRUCTURES"
        },
        {
          "text": "written consent of Grantee.",
          "bbox": [
            0.08823529411764706,
            0.5799999999999998,
            0.2746029411764706,
            0.5943939393939391
          ]
        },
        {
          "text": "Temporary paving and striping may be permitted provided it does not materially interfere with",
          "bbox": [
            0.08823529411764706,
            0.5636363636363635,
            0.7257753267973855,
            0.5780303030303028
          ]
        },
        {
          "text": "utility operations.",
          "bbox": [
            0.08823529411764706,
            0.5472727272727271,
            0.20470343137254904,
            0.5616666666666665
          ]
        },
        {
          "text": "Relocation",
          "bbox": [
            0.08823529411764706,
            0.5127272727272726,
            0.18011764705882352,
            0.5293939393939393
          ],
          "anchor": "SECTION_RELOCATION"
        },
        {
          "text": "Grantor reserves a right to request relocation of the utility facilities, subject to Grantee's",
          "bbox": [
            0.08823529411764706,
            0.4927272727272727,
            0.6856331699346405,
            0.5071212121212121
          ],
          "anchor": "RELOCATION_RIGHT"
        },
        {
          "text": "reasonable approval and at Grantor's sole cost and expense.",
          "bbox": [
            0.08823529411764706,
            0.4763636363636363,
            0.5070890522875817,
            0.49075757575757567
          ]
        },
        {
          "text": "Relocation shall not unreasonably interrupt service.",
          "bbox": [
            0.08823529411764706,
            0.45999999999999996,
            0.44023202614379087,
            0.47439393939393937
          ]
        },
        {
          "text": "Exhibit B",
          "bbox": [
            0.08823529411764706,
            0.4254545454545455,
            0.16613398692810458,
            0.44212121212121214
          ],
          "anchor": "SECTION_EXHIBIT_B"
        },
        {
          "text": "EXHIBIT B is attached and depicts the easement area (synthetic).",
          "bbox": [
            0.08823529411764706,
            0.4054545454545455,
            0.5403390522875817,
            0.4198484848484849
          ],
          "anchor": "EXHIBIT_B_NOTE"
        },
        {
          "text": "Easement Area: a strip of land along the north (or east) boundary line as depicted on the Site",
          "bbox": [
            0.08823529411764706,
            0.3890909090909092,
            0.7267377450980392,
            0.40348484848484856
          ]
        },
        {
          "text": "Plan.",
          "bbox": [
            0.08823529411764706,
            0.37272727272727285,
            0.12361192810457515,
            0.3871212121212122
          ]
        }
      ]
    }
  ]
