        {
          "text": "Grant",
          "bbox": [
            0.08823529411764706,
            0.1924242424242424,
            0.13617156862745097,
            0.2090909090909091
          ],
          "anchor": "SECTION_GRANT"
        },
        {
          "text": "Grantor grants to Grantee a perpetual easement for ingress and egress over the Access Drive as",
          "bbox": [
            0.08823529411764706,
            0.21469696969696983,
            0.7542908496732027,
            0.22909090909090912
          ],
          "anchor": "ACCESS_GRANT"
        },
        {
          "text": "shown on Exhibit A.",
          "bbox": [
            0.08823529411764706,
            0.2310606060606062,
            0.22455718954248366,
            0.2454545454545456
          ]
        },
        {
          "text": "The easement includes the right to use the Access Drive for pedestrian and vehicular access to a",
          "bbox": [
            0.08823529411764706,
            0.24742424242424266,
            0.7551601307189543,
            0.26181818181818195
          ]
        },
        {
          "text": "public road.",
          "bbox": [
            0.08823529411764706,
            0.263787878787879,
            0.1684730392156863,
            0.2781818181818184
          ]
        },
        {
          "text": "Maintenance",
          "bbox": [
            0.08823529411764706,
            0.29606060606060625,
            0.1971029411764706,
            0.31272727272727296
          ],
          "anchor": "SECTION_MAINTENANCE"
        },
        {
          "text": "The parties shall share maintenance costs in proportion to use, unless otherwise agreed in writing.",
          "bbox": [
            0.08823529411764706,
            0.3183333333333336,
            0.762906045751634,
            0.332727272727273
          ],
          "anchor": "MAINT_COSTS"
        },
        {
          "text": "Termination",
          "bbox": [
            0.08823529411764706,
            0.3506060606060608,
            0.1910996732026144,
            0.36727272727272753
          ],
          "anchor": "SECTION_TERMINATION"
        },
        {
          "text": "This easement shall run with the land and shall not be terminable so long as the benefited parcel",
          "bbox": [
            0.08823529411764706,
            0.37287878787878814,
            0.7508758169934641,
            0.38727272727272755
          ],
          "anchor": "RUNS_WITH_LAND"
        },
        {
          "text": "requires access.",
          "bbox": [
