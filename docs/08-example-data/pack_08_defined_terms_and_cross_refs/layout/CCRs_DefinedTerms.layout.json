        {
          "text": "Article I - Definitions",
          "bbox": [
            0.08823529411764706,
            0.1924242424242424,
            0.26301307189542483,
            0.2090909090909091
          ],
          "anchor": "SECTION_ARTICLE_I_DEFINITIONS"
        },
        {
          "text": "\"Easement Area\" means the areas designated as easements on the Site Plan attached as Exhibit C.",
          "bbox": [
            0.08823529411764706,
            0.21469696969696983,
            0.7765816993464053,
            0.22909090909090912
          ],
          "anchor": "DEF_EASEMENT_AREA"
        },
        {
          "text": "\"Approved Plans\" means the plans approved by the Architectural Committee pursuant to Section 4.3.",
          "bbox": [
            0.08823529411764706,
            0.2310606060606062,
            0.7808660130718954,
            0.2454545454545456
          ],
          "anchor": "DEF_APPROVED_PLANS"
        },
        {
          "text": "\"Declarant\" means Pine Street Retail Owner LLC and its successors and assigns.",
          "bbox": [
            0.08823529411764706,
            0.24742424242424266,
            0.6479436274509804,
            0.26181818181818195
          ],
          "anchor": "DEF_DECLARANT"
        },
        {
          "text": "Article IV - Use Restrictions",
          "bbox": [
            0.08823529411764706,
            0.2796969696969698,
            0.32396241830065364,
            0.2963636363636365
          ],
          "anchor": "SECTION_ARTICLE_IV_USE_RESTRICTIONS"
        },
        {
          "text": "No Building shall be constructed within the Easement Area, except as expressly permitted under",
          "bbox": [
            0.08823529411764706,
            0.3019696969696972,
            0.7491062091503268,
            0.3163636363636366
          ],
          "anchor": "USE_RESTRICTION"
        },
        {
          "text": "Section 5.2.",
          "bbox": [
            0.08823529411764706,
            0.3183333333333336,
            0.17021160130718954,
            0.332727272727273
          ]
        },
        {
          "text": "Retail use is permitted; industrial use is prohibited.",
          "bbox": [
            0.08823529411764706,
            0.33469696969697005,
            0.43417810457516337,
            0.34909090909090945
          ],
          "anchor": "USE_PROHIBITED"
        },
        {
          "text": "Any exterior signage is subject to approval under the Approved Plans process.",
          "bbox": [
            0.08823529411764706,
            0.3510606060606063,
            0.6266151960784313,
            0.3654545454545457
          ]
        },
        {
          "text": "Section 4.3 - Architectural Control",
          "bbox": [
            0.08823529411764706,
            0.3833333333333335,
            0.3788725490196079,
            0.40000000000000024
          ],
          "anchor": "SECTION_SECTION_4_3_ARCHITECTURAL_CONT"
        },
        {
          "text": "All exterior alterations require prior written approval of the Architectural Committee.",
          "bbox": [
            0.08823529411764706,
            0.40560606060606086,
            0.6567295751633987,
            0.42000000000000015
          ],
          "anchor": "ARCH_APPROVAL"
        },
        {
          "text": "Exhibit C Reference",
          "bbox": [
            0.08823529411764706,
            0.4378787878787881,
            0.25803431372549024,
            0.4545454545454547
          ],
          "anchor": "SECTION_EXHIBIT_C_REFERENCE"
        },
        {
          "text": "See Exhibit C for the Site Plan depicting the Easement Area and Common Access Drive.",
