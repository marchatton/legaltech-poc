        {
          "text": "Grant",
          "bbox": [
            0.08823529411764706,
            0.7909090909090909,
            0.13617156862745097,
            0.8075757575757576
          ],
          "anchor": "SECTION_GRANT"
        },
        {
          "text": "Grantor grants to Grantee a perpetual easement for ingress and egress over the Access Drive as",
          "bbox": [
            0.08823529411764706,
            0.7709090909090909,
            0.7542908496732027,
            0.7853030303030302
          ],
          "anchor": "ACCESS_GRANT"
        },
        {
          "text": "shown on Exhibit A.",
          "bbox": [
            0.08823529411764706,
            0.7545454545454544,
            0.22455718954248366,
            0.7689393939393938
          ]
        },
        {
          "text": "The easement includes the right to use the Access Drive for pedestrian and vehicular access to a",
          "bbox": [
            0.08823529411764706,
            0.738181818181818,
            0.7551601307189543,
            0.7525757575757573
          ]
        },
        {
          "text": "public road.",
          "bbox": [
            0.08823529411764706,
            0.7218181818181816,
            0.1684730392156863,
            0.736212121212121
          ]
        },
        {
          "text": "Maintenance",
          "bbox": [
            0.08823529411764706,
            0.687272727272727,
            0.1971029411764706,
            0.7039393939393938
          ],
          "anchor": "SECTION_MAINTENANCE"
        },
        {
          "text": "The parties shall share maintenance costs in proportion to use, unless otherwise agreed in writing.",
          "bbox": [
            0.08823529411764706,
            0.667272727272727,
            0.762906045751634,
            0.6816666666666664
          ],
          "anchor": "MAINT_COSTS"
        },
        {
          "text": "Termination",
          "bbox": [
            0.08823529411764706,
            0.6327272727272725,
            0.1910996732026144,
            0.6493939393939392
          ],
          "anchor": "SECTION_TERMINATION"
        },
        {
          "text": "This easement shall run with the land and shall not be terminable so long as the benefited parcel",
          "bbox": [
            0.08823529411764706,
            0.6127272727272725,
            0.7508758169934641,
            0.6271212121212119
          ],
          "anchor": "RUNS_WITH_LAND"
